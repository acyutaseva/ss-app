{
  "name": "ss-app-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:schema": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f src/db/schema.sql'",
    "db:seed": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f src/db/seed.sql'",
    "db:student-seed": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f src/db/student-seed.sql'",
    "db:reset": "dotenv -e .env -- sh -c 'psql \"$DATABASE_URL\" -f src/db/reset.sql'",
    "db:reseed": "npm run db:reset && npm run db:seed",
    "db:reseed:full": "npm run db:reset && npm run db:seed && npm run db:student-seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.4",
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
